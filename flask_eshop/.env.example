# Copy to .env and fill in. Flask loads .env automatically (python-dotenv).

# Signs session cookies. If unset, a random key is generated in instance/secret_key.
SECRET_KEY=

# Credentials for the admin account created on first run.
# If ADMIN_PASSWORD is unset, a random password is generated and printed once.
ADMIN_EMAIL=admin@eshop.com
ADMIN_PASSWORD=
